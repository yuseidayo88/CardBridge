# =============================================================================
# CardBridge environment variables
#
# EVERY value here is SERVER-ONLY. No NEXT_PUBLIC_ prefixes are used anywhere in
# this project: all database access goes through Server Actions / Route Handlers,
# so the browser bundle never needs a Supabase key of any kind.
#
# Copy to .env.local and fill in. Never commit the filled-in file.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Anon key: used ONLY to authenticate the admin's browser session (magic link).
# It is read server-side and never sent to the client bundle.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# Public origin of this app. Used to build the magic-link redirect target.
APP_URL=http://localhost:3000

# --- Encryption -------------------------------------------------------------
# 32 random bytes, base64 encoded. Used for AES-256-GCM at-rest encryption of
# eBay OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- eBay -------------------------------------------------------------------
EBAY_ENV=SANDBOX
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
# The RuName, NOT a URL. eBay names your redirect target rather than using the
# URL directly, so this looks like "Yourname-Appname-SBX-xxxxxxxxx-xxxxxxxx".
EBAY_REDIRECT_URI=
# Which seller account the stored tokens belong to. One deployment, one seller,
# so the default is fine until a second account exists.
EBAY_ACCOUNT=default
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# --- Safety interlocks ------------------------------------------------------
# DRY_RUN=true suppresses every mutating eBay call. Both DRY_RUN=false AND
# ALLOW_PRODUCTION_PUBLISH=true are required before anything reaches production.
DRY_RUN=true
ALLOW_PRODUCTION_PUBLISH=false
MAX_PUBLISH_PER_RUN=5

# --- AI ---------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_MIN_CONFIDENCE=0.85

# --- Supplier fetching ------------------------------------------------------
SCRAPER_USER_AGENT=CardBridgeBot/1.0 (+https://example.com/contact)
SCRAPER_MAX_CONCURRENCY=1
SCRAPER_MIN_INTERVAL_MS=3000
SCRAPER_RESPECT_ROBOTS=true

# --- FX & notifications -----------------------------------------------------
FX_API_KEY=
SLACK_WEBHOOK_URL=
