node_modules/
dist/
.next/
out/
coverage/
*.tsbuildinfo

# Secrets - never commit
.env
.env.local
.env.*.local
!.env.example

# Live snapshots of partner pages are large and are someone else's content:
# keep the generated reports, ignore the raw dumps. Sharing one deliberately is
# still possible with `git add -f`.
docs/research/**/*.html
docs/research/**/raw/
# The synthetic fixtures are the exception. They are not copies of any partner
# page, and generic-cart-adapter.test.ts reads them at runtime -- ignoring them
# makes the test suite fail on a fresh clone.
!docs/research/fixtures/*.html

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
